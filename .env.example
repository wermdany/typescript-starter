# ============================================================
# 环境变量模板 —— 复制为 .env 后按需修改
#   cp .env.example .env
# 敏感变量（密钥/凭证）不要提交到仓库（.env 已 gitignore），
# 生产环境一律由部署平台注入
#
# 本文件只放**底层/运维配置**（随部署环境变化的部分）。
# 业务配置（登录会话、登录安全、Cookie 策略等）不通过环境变量下发，
# 统一写在 src/config/app-config.ts 里，随代码版本管理。
# ============================================================

# ─── 应用 ──────────────────────────────────────────────────

# 运行环境：development | test | production（默认 development）
NODE_ENV=development

# 应用监听端口（默认 8000）
PORT=8000

# ─── 日志 ──────────────────────────────────────────────────

# 日志级别：debug | verbose | log | warn | error | fatal（默认 log；本地调试可在 .env.local 设 LOG_LEVEL=debug）
LOG_LEVEL=log

# 日志文件：默认 logs/app.log（相对路径按 cwd 解析）；留空（LOG_FILE=）则只输出控制台
LOG_FILE=logs/app.log

# 是否把请求体写进日志（脱敏 + 截断）：只接受 true | false（默认 false）
# 排查"写操作为何失败"时临时设为 true
LOG_BODY=false

# ─── 数据库 ────────────────────────────────────────────────

# PostgreSQL 连接串（必填）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learn_nest

# 连接池上限（默认 10）
DB_POOL_MAX=10

# ─── RBAC ──────────────────────────────────────────────────

# 「角色 → 权限码」缓存有效期（秒，默认 60）
# 只约束角色授权表；用户自己的角色集合不缓存，增删角色下一次请求即生效
RBAC_CACHE_TTL_SECONDS=60
